{
  "name": "ai-support-copilot-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the AI Support Copilot portfolio project",
  "author": "Peter Ankelein",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "ai",
    "customer-support",
    "copilot",
    "express",
    "typescript"
  ],
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
